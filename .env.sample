# --- Server
PORT=5000
# "dev" relaxes CORS/origin checks and cookie security for local work
NODE_ENV=dev
# Frontend origins allowed to call the API with cookies (comma separated)
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Frontend URL used in emails and after OAuth sign-in (default: first CLIENT_URLS)
APP_URL=http://localhost:5173
# This API's URL as the browser reaches it. Behind the frontend's /api proxy
# use e.g. https://drawdb.example.com/api
PUBLIC_API_URL=http://localhost:5000
# Reverse proxies in front of the server (Railway: 1)
# TRUST_PROXY=1

# --- Database (accounts and cloud features are off without it)
DATABASE_URL=postgres://drawdb:drawdb@localhost:55432/drawdb
# DATABASE_SSL=true

# --- Sessions
# lax: frontend and API on the same site (same domain, or /api proxy)
# none: frontend and API on different sites (e.g. two *.up.railway.app)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
# SESSION_DAYS=30
# AUTH_REGISTRATION_ENABLED=true
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Limits
# MAX_DIAGRAMS_PER_USER=1000
# MAX_BODY_SIZE=5mb
# Days a deleted diagram stays in the trash
# TRASH_DAYS=30
# Request rate limits; turn off only for automated browser tests
# RATE_LIMIT=true

# --- Version history
# Minutes between automatic versions while editing
# VERSION_INTERVAL_MINUTES=10
# Days to keep unnamed versions (0 = forever); named ones are always kept
# VERSION_RETENTION_DAYS=90

# --- OAuth (each provider is enabled when both values are set)
# Callback URL to register: ${PUBLIC_API_URL}/auth/oauth/<google|github>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Mail (email verification, password reset, invitations)
# Any SMTP server (sign-in optional):
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SECURE=false
# ...or a well-known service with credentials:
MAIL_SERVICE=gmail
MAIL_USERNAME=mail@example.com
# Gmail: an app password (myaccount.google.com/apppasswords)
MAIL_PASSWORD=my-app-password
# MAIL_FROM="drawDB <mail@example.com>"

# --- GitHub gists (sharing and versions until the cloud backend replaces them)
GITHUB_TOKEN=a-gh-token

# --- compose.prod.yaml only
# POSTGRES_PASSWORD=change-me
